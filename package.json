{
  "name": "ninefold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "tsx tools/generate-icons.ts",
    "page": "npm run build && tsx tools/package-page.ts game",
    "lab": "npm run build && tsx tools/package-page.ts lab",
    "overview": "tsx tools/overview.ts",
    "gear-system": "tsx tools/gear-system.ts",
    "catalogue": "tsx tools/catalogue.ts",
    "arts": "tsx tools/arts.ts",
    "prose": "npm run build && tsx tools/prose.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
